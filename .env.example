# Токен admin API для стенда в Docker. Без него стенд не запустится: бэкенды в балансировщик
# добавляются только через admin API.
#
#   cp .env.example .env      и впишите свой токен (сгенерировать: openssl rand -hex 24)
#
# docker compose сам читает файл .env из папки проекта. В git файл .env не попадает (.gitignore).
MYLB_ADMIN_TOKEN=change-me
