# Токен admin API для стенда в Docker. Без него стенд не запустится: бэкенды в балансировщик
# добавляются только через admin API.
#
#   cp .env.example .env      и впишите свой токен (сгенерировать: openssl rand -hex 24)
#
# docker compose сам читает файл .env из папки проекта. В git файл .env не попадает (.gitignore).
MYLB_ADMIN_TOKEN=change-me

# Необязательно. IP-адрес этой машины, на котором балансировщик принимает клиентов (порт 8443).
# Если строки нет, действует 127.0.0.1: балансировщик виден только с этой машины.
#   LB_BIND=192.168.1.10    только сетевой интерфейс с этим адресом (свои адреса: ifconfig | grep "inet ")
#   LB_BIND=0.0.0.0         все интерфейсы
# Метрики (9100) и admin API (9101) всегда остаются на 127.0.0.1.
#LB_BIND=127.0.0.1
